# Server-side configuration. Never include this URI in Flutter or web assets.
DATABASE_URL=
FIREBASE_PROJECT_ID=keening-ece74
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local demo mode also requires a LOCAL Postgres DATABASE_URL:
# FIREBASE_PROJECT_ID=demo-keening
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Server-side invitation code; configure locally and in Secret Manager.
REGISTRATION_CODE=replace-with-your-invitation-code
